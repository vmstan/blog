{
  "name": "virtually-benevolent",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "new": "node scripts/new-entry.mjs",
    "test": "node --test src/lib/credly.test.ts",
    "build": "node scripts/build-icon-css.mjs && astro check && astro build && pagefind --site dist",
    "build:icons": "node scripts/build-icon-css.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "import:ghost": "node scripts/import-ghost.mjs",
    "sync:credly": "node scripts/sync-credly.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "astro": "^7.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "husky": "^9.1.7",
    "pagefind": "^1.5.2",
    "subset-font": "^2.7.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.128.0"
  }
}
