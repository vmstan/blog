---
import { SITE } from "../config";

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title}, home`}>
      <span>{SITE.title}</span>
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          SITE.navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  pathname === item.href ||
                  (item.href !== "/" && pathname.startsWith(item.href))
                    ? "page"
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header-actions">
      <nav class="header-social" aria-label="Social links">
        <a
          href="https://www.threads.com/@vmstan"
          rel="me"
          aria-label="Threads"
          title="Threads"
        >
          <i class="fa-brands fa-threads" aria-hidden="true"></i>
        </a>
        <a
          href="https://x.com/vmstan"
          rel="me"
          aria-label="X-Twitter"
          title="X"
        >
          <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
        </a>
        <a
          href="https://www.linkedin.com/in/vmstan"
          rel="me"
          aria-label="LinkedIn"
          title="LinkedIn"
        >
          <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
        </a>
      </nav>
      <pagefind-modal-trigger
        class="header-search"
        placeholder="Search"
        compact
        hide-shortcut
      ></pagefind-modal-trigger>
    </div>
  </div>
</header>

<pagefind-modal class="site-search-modal" reset-on-close></pagefind-modal>
